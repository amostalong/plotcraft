{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlotCraft",
  "version": "0.1.0",
  "identifier": "com.amostalong.plotcraft",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:14201",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PlotCraft",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#1d1d21"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
