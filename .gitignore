# --- Node / Vite / bun ---
node_modules/
dist/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun.lockb

# --- Rust / Tauri ---
src-tauri/target/
src-tauri/Cargo.lock
src-tauri/gen/
src-tauri/WixTools/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- 环境 / 密钥 ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Tauri 临时 ---
src-tauri/.cargo/
src-tauri/.tauri/

